    "db:seed": "prisma db seed",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.0.12",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdfkit": "^0.20.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^16.6.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.15.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  },
